rules_version = '2';

// Reglas provisionales de Fase 0: deny-all. Se reemplazan en Fase 1 con el
// modelo real de membership (users/{uid}, memberships/{uid}_{tenantId},
// tenants/{tenantId}/**).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

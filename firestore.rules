rules_version = '2';

// Modelo: users/{uid} (perfil global) + memberships/{uid}_{tenantId} (acceso)
// + tenants/{tenantId}/** (datos de cada empresa). Los IDs de Firebase Auth
// (uid) y los IDs autogenerados de Firestore (tenantId) son alfanuméricos
// sin guion bajo, así que "uid_tenantId" se puede separar de forma segura
// con split('_') tomando el primer elemento.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasMembership(tenantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + tenantId));
    }

    // Rol del usuario actual en este tenant — asume que ya se comprobó
    // hasMembership(tenantId) antes de llamar esto (si no hay membership,
    // el get() falla la evaluación, así que siempre se usa junto a
    // hasMembership() con &&, nunca solo).
    function rolDe(tenantId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + tenantId)).data.rol;
    }

    // v1: roles predefinidos de permisos fijos por módulo (ver
    // lib/tenant/roles.ts, MODULOS_POR_ROL — debe mantenerse igual a esto).
    // No son personalizables por persona todavía, así que esta lista vive
    // hardcodeada aquí en vez de leerse de alguna configuración.
    function puedeVender(tenantId)   { return rolDe(tenantId) in ['owner', 'admin', 'vendedor']; }
    function puedeCobranza(tenantId) { return rolDe(tenantId) in ['owner', 'admin', 'contador']; }
    function esOwnerOAdmin(tenantId) { return rolDe(tenantId) in ['owner', 'admin']; }
    // Un cajero (vendedor) no debe poder sumar el total facturado del
    // negocio leyendo todas las facturas — solo dueño/admin/contador ven
    // el libro completo; el cajero solo lee las que él mismo emitió.
    function puedeVerTodasFacturas(tenantId) { return rolDe(tenantId) in ['owner', 'admin', 'contador']; }

    // Un tenant "activo" ya está certificado y factura de verdad ante la
    // DGII — a partir de ahí, los campos que certifican una respuesta real
    // de la DGII nunca pueden originarse en una escritura del cliente.
    function tenantActivo(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.estado == "activo";
    }

    // Solo el backend (Admin SDK, que ignora estas reglas) puede crear o
    // modificar estos campos en una factura — son la prueba de que un e-CF
    // fue realmente firmado y aceptado por la DGII. Sin esto, cualquier
    // miembro del tenant podría fabricar un comprobante "Aceptado" desde la
    // consola del navegador sin que pasara nunca por /api/facturas/emitir.
    function noToca(campos) {
      return resource == null
        ? !request.resource.data.keys().hasAny(campos)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    function camposFiscalesFactura() {
      return ['estadoDGII', 'trackIdDGII', 'xmlFirmado', 'urlQR', 'codigoSeguridad', 'signatureValue', 'fechaEnvioDGII'];
    }

    // ── Perfil de usuario (global, no tenant-scoped) ──
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Membership: cada usuario solo ve las suyas; nunca se escriben
    //    desde el cliente (las crea el backend con Admin SDK al certificarse
    //    o al ser invitado) ──
    match /memberships/{membershipId} {
      allow read: if isSignedIn() && membershipId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // ── Tenants: solo lectura para miembros; toda escritura (creación,
    //    cambios de estado, asignación de slug) pasa por el backend ──
    match /tenants/{tenantId} {
      allow read: if hasMembership(tenantId);
      allow write: if false;

      // Datos sensibles del emisor (certificado .p12 cifrado, token DGII,
      // secuencias de e-CF): nunca expuestos al cliente, ni siquiera lectura.
      match /config/certificado { allow read, write: if false; }
      match /config/dgii_token  { allow read, write: if false; }
      match /config/secuencias  { allow read, write: if false; }

      // Datos de empresa visibles para mostrarlos en UI (nombre, RNC, etc.).
      match /config/empresa {
        allow read: if hasMembership(tenantId);
        allow write: if false;
      }

      // Logo de la factura impresa: lo escribe el backend después de
      // procesar la imagen subida (redimensionar/convertir) — el cliente
      // nunca escribe la URL directamente.
      match /config/personalizacion {
        allow read: if hasMembership(tenantId);
        allow write: if false;
      }

      // Estado del wizard de certificación: visible para miembros, lo
      // actualiza el backend.
      match /certificacion/{paso} {
        allow read: if hasMembership(tenantId);
        allow write: if false;
      }

      // Suscripción de cobro recurrente (Pagadito Tokenización): visible
      // para miembros (para mostrar el estado en el panel), pero
      // payment_token/subscription_code solo los escribe el backend tras
      // tokenizar la tarjeta — nunca el cliente directamente.
      match /facturacion/{doc} {
        allow read: if hasMembership(tenantId);
        allow write: if false;
      }

      // Datos operativos del negocio: la lectura queda abierta a cualquier
      // miembro (un cajero necesita poder LEER productos para facturarlos,
      // aunque no pueda editarlos) — la escritura sí se restringe por rol.
      // IMPORTANTE: Firestore evalúa el OR de todos los bloques match que
      // coincidan con una ruta — un wildcard genérico aquí (/{collection}/
      // {docId}) volvería a exponer config/certificado pese a la regla
      // "if false" de arriba. Por eso se enumeran las colecciones
      // operativas en vez de usar un wildcard.
      match /clientes/{docId} {
        allow read:  if hasMembership(tenantId);
        allow write: if hasMembership(tenantId) && (puedeVender(tenantId) || puedeCobranza(tenantId));
      }
      // Servicios/productos (inventario): solo owner/admin — un cajero
      // puede vender lo que ya existe en el catálogo, pero no crear
      // productos ni tocar precios/stock.
      match /servicios/{docId} { allow read: if hasMembership(tenantId); allow write: if hasMembership(tenantId) && esOwnerOAdmin(tenantId); }
      match /productos/{docId} { allow read: if hasMembership(tenantId); allow write: if hasMembership(tenantId) && esOwnerOAdmin(tenantId); }
      // Facturas: el cliente puede crear/editar libremente mientras el
      // tenant está en sandbox (datos simulados), y siempre puede cambiar
      // el estado de negocio de una factura real (pagada/anulada/notas) —
      // pero una vez el tenant está activo, nunca puede tocar los campos
      // que certifican una respuesta real de la DGII (los escribe
      // /api/facturas/emitir con el Admin SDK, que ignora estas reglas).
      // Solo owner/admin/vendedor pueden facturar; un contador o viewer no.
      match /facturas/{docId} {
        // Un vendedor solo puede leer las facturas que él mismo creó
        // (resource.data.creadoPor == su uid) — el cliente tiene que
        // consultar con un where("creadoPor", "==", uid) para que Firestore
        // no rechace el list() completo; ver hooks/use-facturas.ts.
        allow read:   if hasMembership(tenantId) && (puedeVerTodasFacturas(tenantId) || resource.data.creadoPor == request.auth.uid);
        allow create: if hasMembership(tenantId) && puedeVender(tenantId) && (!tenantActivo(tenantId) || noToca(camposFiscalesFactura()));
        allow update: if hasMembership(tenantId) && puedeVender(tenantId) && (!tenantActivo(tenantId) || noToca(camposFiscalesFactura()));
        allow delete: if hasMembership(tenantId) && esOwnerOAdmin(tenantId) && !tenantActivo(tenantId);
      }
      match /cotizaciones/{docId} {
        allow read:  if hasMembership(tenantId);
        allow write: if hasMembership(tenantId) && puedeVender(tenantId);
      }
      match /cuentas_por_cobrar/{docId} {
        allow read:  if hasMembership(tenantId);
        allow write: if hasMembership(tenantId) && puedeCobranza(tenantId);
      }
      match /facturas_recibidas/{docId} {
        allow read:  if hasMembership(tenantId);
        allow write: if hasMembership(tenantId) && puedeCobranza(tenantId);
      }
      // Métodos de pago: solo datos de visualización (marca, últimos 4
      // dígitos, vencimiento) — nunca el número completo de tarjeta ni CVV,
      // así que no requiere el mismo aislamiento que /config/certificado.
      // Es un tema de facturación de la cuenta, no operativo — solo owner/admin.
      match /metodos_pago/{docId} {
        allow read:  if hasMembership(tenantId);
        allow write: if hasMembership(tenantId) && esOwnerOAdmin(tenantId);
      }
    }
  }
}

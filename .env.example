# Firebase (proyecto: sass-facturacion) — cliente
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dominio raíz del SaaS (sin protocolo, usado por el middleware de subdominios)
NEXT_PUBLIC_ROOT_DOMAIN=facturacon.cfd

# Opcional — si se define, el landing muestra el video embebido en vez del
# placeholder "próximamente". Acepta youtube.com/watch?v=... o youtu.be/...
NEXT_PUBLIC_YOUTUBE_TUTORIAL_URL=

# Google Cloud KMS (cifrado de certificados .p12) — Fase 2
# Reusa las credenciales de la service account de FIREBASE_* arriba (necesita
# el rol roles/cloudkms.cryptoKeyEncrypterDecrypter sobre esta key).
KMS_PROJECT_ID=sass-facturacion
KMS_LOCATION=us
KMS_KEY_RING=facturacon
KMS_KEY_NAME=p12-vault

# PayPal — Fase 6
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Mismo valor que PAYPAL_CLIENT_ID — no es secreto, lo usa el SDK de botones en el navegador.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
